<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070C"
    android:fillViewport="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RVWineBoxGames"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:overScrollMode="never"
            android:focusable="false"
            android:nextFocusDown="@id/chipLastGame" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chipLastGame"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/winebox_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="▶  Ultimo gioco · 75%"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:nextFocusUp="@id/RVWineBoxGames"
                    android:nextFocusDown="@id/cardStatistics"
                    android:nextFocusRight="@id/chipAddGame" />

                <TextView
                    android:id="@+id/chipAddGame"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/winebox_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="＋  Aggiungi gioco"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:nextFocusUp="@id/RVWineBoxGames"
                    android:nextFocusDown="@id/cardStatistics"
                    android:nextFocusLeft="@id/chipLastGame"
                    android:nextFocusRight="@id/chipCustomize" />

                <TextView
                    android:id="@+id/chipCustomize"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/winebox_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="⚙  Personalizza"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:nextFocusUp="@id/RVWineBoxGames"
                    android:nextFocusDown="@id/cardNews"
                    android:nextFocusLeft="@id/chipAddGame" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/cardStatistics"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="1"
                android:background="@drawable/winebox_card"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/chipLastGame"
                android:nextFocusRight="@id/cardNews"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/winebox_statistics"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="12,5"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/winebox_played_hours"
                    android:textColor="#AAB2C0"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="8"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/winebox_games_count"
                    android:textColor="#AAB2C0"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNews"
                android:layout_width="0dp"
                android:layout_height="190dp"
                android:layout_weight="2"
                android:layout_marginStart="10dp"
                android:background="@drawable/winebox_card"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@id/chipCustomize"
                android:nextFocusLeft="@id/cardStatistics"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/winebox_news"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="10dp"
                    android:background="#202838"
                    android:contentDescription="@string/winebox_news"
                    android:padding="22dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_shortcut" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:text="@string/winebox_news_title"
                    android:textColor="#E9EDF5"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>