<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/winebox_game_card_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="142dp">

        <ImageView
            android:id="@+id/ImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#202020"
            android:contentDescription="@string/shortcuts"
            android:scaleType="centerCrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="top|left"
            android:layout_margin="8dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:background="@drawable/winebox_chip_background"
            android:text="WINDOWS"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </FrameLayout>

    <TextView
        android:id="@+id/TVTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4F7FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/TVSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LAUNCH GAME"
            android:textColor="#EEEEEE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <ImageView
            android:id="@+id/BTRun"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/winebox_play_button"
            android:contentDescription="@string/run"
            android:padding="10dp"
            android:src="@drawable/icon_run" />

        <ImageView
            android:id="@+id/BTMenu"
            android:layout_width="34dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:contentDescription="@string/settings"
            android:padding="9dp"
            android:src="@drawable/icon_list_item_menu" />
    </LinearLayout>
</LinearLayout>