<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808">

    <ImageView
        android:id="@+id/BackgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.30"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="22dp"
            android:background="#66000000">

            <TextView
                android:id="@+id/BTDrawer"
                android:layout_width="34dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="28dp"
                android:layout_marginLeft="20dp"
                android:gravity="center"
                android:background="@drawable/winebox_chip_background"
                android:text="LB"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="26dp"
                android:text="MY"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:text="DISCOVER"
                android:textColor="#A0A0A0"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:text="FIND GAMES"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:layout_width="34dp"
                android:layout_height="28dp"
                android:layout_marginLeft="24dp"
                android:gravity="center"
                android:background="@drawable/winebox_chip_background"
                android:text="RB"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/BTSearch"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#FFFFFF"
                android:textSize="31sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="18dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="22dp"
            android:paddingRight="24dp"
            android:background="#66000000">

            <TextView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:text="Y"
                android:textColor="#111111"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/winebox_footer_key"
                android:layout_marginRight="9dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textColor="#DDDDDD"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:text="☰"
                android:textColor="#111111"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/winebox_footer_key"
                android:layout_marginRight="9dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textColor="#DDDDDD"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/TVEmptyText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:text="Your library is empty\nAdd a Windows shortcut to get started."
        android:textColor="#EEEEEE"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/BTPaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:layout_margin="72dp"
        android:src="@drawable/icon_paste"
        android:tint="#FFFFFF"
        android:backgroundTint="#555555"
        android:visibility="gone" />
</FrameLayout>